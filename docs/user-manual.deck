        }
       ]
      }
     ]
    },
    {
     "id": "tx-f059",
     "type": "text",
     "x": 64,
     "y": 350,
     "w": 400,
     "h": 34,
     "valign": "top",
     "fill": null,
     "lineColor": null,
     "paras": [
      {
       "align": "center",
       "runs": [
        {
         "text": "一格虛線、每 5 格細實線、每 10 格粗實線；",
         "sizePt": 10,
         "bold": false,
         "color": "888888"
        }
       ]
      },
      {
       "align": "center",
       "runs": [
        {
         "text": "搬移只吸左緣與上緣，拖白點縮放才四邊都吸。",
         "sizePt": 10,
         "bold": false,
         "color": "888888"
        }
       ]
      }
     ]
    },
    {
     "id": "sh-f063",
     "type": "shape",
     "shape": "rect",
     "x": 660,
