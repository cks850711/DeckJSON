       "spaceAfter": 4,
       "runs": [
        {
         "text": "先設筆，再選邊",
         "sizePt": 10,
         "color": "1A1A1A",
         "bold": true
        },
        {
         "text": "：用右欄的「框線筆」設好線寬與顏色，再點全部、外框、內部，或上下左右單邊。「無」是清掉框線。",
         "sizePt": 10,
         "color": "1A1A1A"
        }
