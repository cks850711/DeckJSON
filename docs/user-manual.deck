    {
     "id": "cp-zh",
     "type": "text",
     "x": 40,
     "y": 406,
     "w": 580,
     "h": 40,
     "valign": "top",
     "fill": null,
     "lineColor": null,
     "paras": [
      {
       "align": "left",
       "runs": [
        {
         "text": "格線只活在畫布上，不會匯出。",
