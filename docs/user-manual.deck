  {
   "id": "p-edit-snap",
   "name": "格線與吸附",
   "notes": "配圖代號：edit-snap\n（tools/figdeck.js import 以此對應到 HELP_FIGS）",
   "elements": [
    {
     "id": "ti-zh",
     "type": "text",
     "x": 40,
     "y": 34,
     "w": 580,
     "h": 40,
     "valign": "middle",
     "fill": null,
     "lineColor": null,
     "paras": [
      {
       "align": "left",
       "runs": [
        {
         "text": "格線與吸附",
