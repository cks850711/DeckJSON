{
  "//layers": "由下往上。下層只准被上層引用。模組名是 src/app/ 底下去掉 .js 的路徑，「資料夾/*」代表整個資料夾。",
  "layers": [
    ["core/i18n", "core/config"],
    ["model/*", "chart/native-map"],
    ["core/state", "io/*"],
    ["render/*", "media/*", "export/*"],
    ["edit/*", "ui/*", "chart/chart-modal", "help/*", "boot"]
  ],
  "//allow": "既有的往上引用（模組 → 名稱）。只准縮小：修掉一條就刪一條，modcheck 會提醒過期項目。",
  "allow": [
    "core/config → APP",
    "core/state → buildChartVis",
    "core/state → renderAll",
    "core/state → setMasterEdit",
    "export/package → renderAll",
    "export/pptx → SHADOW_DEF",
    "io/autosave → renderAll",
    "io/autosave → syncPageJson",
    "io/clipboard → deleteSelected",
    "io/clipboard → renderAll",
    "io/clipboard → syncPageJson",
    "io/container → renderAll",
    "io/container → syncPageJson",
    "io/file → checkFonts",
    "io/file → renderAll",
    "io/file → setPage",
    "io/file → syncPageJson",
    "media/image → renderAll",
    "media/image → renderProps",
    "media/image → syncPageJson",
    "media/video → addEl",
    "media/video → insertImageFile",
    "media/video → renderAll",
    "media/video → renderProps",
    "model/geom → APP",
    "model/geom → NS",
    "model/normalize → GRAD_MAX",
    "model/normalize → SHADOW_DEF",
    "model/normalize → TRANSITIONS",
    "model/normalize → looksLikeAssetRef",
    "model/normalize → normCrop",
    "model/normalize → ytEmbed",
    "model/table → APP",
    "model/table → commitUndo",
    "model/table → renderProps",
    "model/table → renderStage",
    "model/table → tableDom",
    "model/table → updateSelBox",
    "render/selection → drag",
    "render/selection → renderLayers",
    "render/selection → renderProps",
    "render/selection → setIcoBtn",
    "render/stage → editOpen",
    "render/stage → shadowCss",
    "render/stage → syncMelBtn"
  ]
}
